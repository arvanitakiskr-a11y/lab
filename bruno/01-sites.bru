meta {
  name: Sites Alpha
  type: http
  seq: 1
}

get {
  url: http://127.0.0.1:8000/sites
  body: none
  auth: none
}

headers {
  X-Demo-Token: alpha-demo
}

tests {
  test("Only Alpha site", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().map(s => s.id)).to.eql([1]);
  });
}
